From a7182b3c4d5e6f7081929304a5b6c7d8e9f0a1b2c Mon Sep 17 00:00:00 2001
From: Chris Lu <lu@alcg.io>
Date: Sun, 24 May 2026 23:30:00 -0400
Subject: [PATCH] librados_asio: thread trace_ctx through async_operate read

librados-read-trace.patch added a jspan_context parameter to
librados::async_operate for ObjectReadOperation (mirroring the write
variant), but only the SIGNATURE was updated - the lambda body
inside still called the 5-arg io.aio_operate(...) overload that
discards trace context. RGW writes through async_operate threaded
the context correctly because the write lambda was already updated.

After rgw_op.cc populates ReadOp::params.trace_ctx and rgw_aio.cc's
aio_abstract<ObjectReadOperation> creates a rados_read span and
passes effective_trace_ctx into librados::async_operate, the next
hop (this function) must forward trace_ctx to the new 6-arg
aio_operate read overload. Otherwise the OSD's MOSDOp arrives with
no parent and op-request-created starts a new orphan trace.

Capture trace_ctx in the lambda and pass it to io.aio_operate.

After this, S3 GETs on multi-chunk objects (>= rgw_get_obj_max_req_size,
default 4 MiB) link end-to-end:
  rgw get_obj -> execute -> get_obj_data
    -> rados_read (per chunk)
      -> op-request-created -> ... -> bluestore_read

Co-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>
---
 src/librados/librados_asio.h | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

--- a/src/librados/librados_asio.h
+++ b/src/librados/librados_asio.h
@@ -220,18 +220,24 @@ auto async_operate(IoExecutor ex, IoCtx& io, const std::string& oid,
   using Signature = typename Op::Signature;
   return boost::asio::async_initiate<CompletionToken, Signature>(
       [] (auto handler, IoExecutor ex, const IoCtx& i, const std::string& oid,
-          ObjectReadOperation read_op, int flags) {
+          ObjectReadOperation read_op, int flags,
+          const jspan_context* trace_ctx) {
         constexpr bool is_read = true;
         auto p = Op::create(ex, is_read, std::move(handler));
         auto& op = p->user_data;
 
         auto& io = const_cast<IoCtx&>(i);
+        // Thread trace_ctx through the jspan-aware aio_operate read overload
+        // (added by ceph-20.1.1-librados-read-trace.patch) so the OSD's
+        // op-request-created span links under the rgw rados_read parent.
         int ret = io.aio_operate(oid, op.aio_completion.get(), &read_op,
-                                 flags, &op.result);
+                                 flags, &op.result, trace_ctx);
         if (ret < 0) {
           auto ec = boost::system::error_code{-ret, librados::detail::err_category()};
           ceph::async::post(std::move(p), ec, 0, bufferlist{});
         } else {
           p.release(); // release ownership until completion
         }
-      }, token, ex, io, oid, std::move(read_op), flags);
+      }, token, ex, io, oid, std::move(read_op), flags, trace_ctx);
 }
