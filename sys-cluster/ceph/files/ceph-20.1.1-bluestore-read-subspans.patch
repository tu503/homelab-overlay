 src/os/bluestore/BlueStore.cc           | 33 +++++++++++++++++++++++--------
 src/os/bluestore/BlueStore.h            |  3 ++-
 src/os/memstore/MemStore.cc             |  3 ++-
 src/os/memstore/MemStore.h              |  3 ++-
 src/osd/PGBackend.h                     |  3 ++-
 src/osd/PrimaryLogPG.cc                 | 28 ++++++++++++++++++++-----
 src/osd/ReplicatedBackend.cc            |  5 +++--
 src/osd/ReplicatedBackend.h             |  3 ++-
