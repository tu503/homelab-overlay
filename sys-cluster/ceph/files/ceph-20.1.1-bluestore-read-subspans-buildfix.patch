From d3e4f50617283940a5b6c7d8e9f0a1b2c3d4e5f6 Mon Sep 17 00:00:00 2001
From: Chris Lu <lu@alcg.io>
Date: Sun, 24 May 2026 17:50:00 -0400
Subject: [PATCH] osd: build-fix for bluestore-read-subspans against gcc 15 +
 opentelemetry-cpp 1.24

The ceph-20.1.1-bluestore-read-subspans.patch added a
`const jspan_context *parent_trace = nullptr` to ObjectStore::read
plus the PGBackend::objects_read_sync virtual, but missed two
override sites that gcc 15 now treats as hard errors:

  * ECSwitch::objects_read_sync (delegates to optimized/legacy
    backends, both also need the new param)
  * ECBackend::objects_read_sync and ECBackendL::objects_read_sync
    (return -EOPNOTSUPP for EC pools; just accept and ignore the
    new param so the override matches)

It also default-constructed jspan_context in PrimaryLogPG.cc at
the four read sites (hsa_parent, read_parent, chunk_parent,
dedup_parent). opentelemetry-cpp 1.24 removed the SpanContext
default constructor; only the explicit `SpanContext(bool,bool)`
remains. Switch to `jspan_context xyz{false, false};` everywhere
(no behavior change - the value gets overwritten if the op has
osd_parent_span, otherwise xyz_ptr is left nullptr).

Without this the OSD module fails to compile on Gentoo with
gcc 15.x + dev-cpp/opentelemetry-cpp-1.24.0.

Co-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>
---
--- a/src/osd/ECSwitch.h
+++ b/src/osd/ECSwitch.h
@@ -258,12 +258,13 @@
   }
 
   int objects_read_sync(const hobject_t &hoid, uint64_t off, uint64_t len,
-                        uint32_t op_flags, ceph::buffer::list *bl) override
+                        uint32_t op_flags, ceph::buffer::list *bl,
+                        const jspan_context *parent_trace = nullptr) override
   {
     if (is_optimized()) {
-      return optimized.objects_read_sync(hoid, off, len, op_flags, bl);
+      return optimized.objects_read_sync(hoid, off, len, op_flags, bl, parent_trace);
     }
-    return legacy.objects_read_sync(hoid, off, len, op_flags, bl);
+    return legacy.objects_read_sync(hoid, off, len, op_flags, bl, parent_trace);
   }
 
   void objects_read_async(
--- a/src/osd/ECBackend.h
+++ b/src/osd/ECBackend.h
@@ -134,7 +134,8 @@
       uint64_t off,
       uint64_t len,
       uint32_t op_flags,
-      ceph::buffer::list *bl
+      ceph::buffer::list *bl,
+      const jspan_context *parent_trace = nullptr
     );
 
   /**
--- a/src/osd/ECBackend.cc
+++ b/src/osd/ECBackend.cc
@@ -1007,7 +1007,8 @@
     uint64_t off,
     uint64_t len,
     uint32_t op_flags,
-    bufferlist *bl) {
+    bufferlist *bl,
+    const jspan_context *parent_trace) {
   return -EOPNOTSUPP;
 }
 
--- a/src/osd/ECBackendL.h
+++ b/src/osd/ECBackendL.h
@@ -121,7 +121,8 @@
     uint64_t off,
     uint64_t len,
     uint32_t op_flags,
-    ceph::buffer::list *bl);
+    ceph::buffer::list *bl,
+    const jspan_context *parent_trace = nullptr);
 
   /**
    * Async read mechanism
--- a/src/osd/ECBackendL.cc
+++ b/src/osd/ECBackendL.cc
@@ -1569,7 +1569,8 @@
   uint64_t off,
   uint64_t len,
   uint32_t op_flags,
-  bufferlist *bl)
+  bufferlist *bl,
+  const jspan_context *parent_trace)
 {
   return -EOPNOTSUPP;
 }
--- a/src/osd/PrimaryLogPG.cc
+++ b/src/osd/PrimaryLogPG.cc
@@ -1611,10 +1611,10 @@
 	    wait_for_unreadable_object(oid, op);
 	    return;
 	  }
-	  jspan_context hsa_parent;
+	  jspan_context hsa_parent{false, false};
 	  const jspan_context *hsa_parent_ptr = nullptr;
-	  if (ctx->op && ctx->op->osd_parent_span) {
-	    hsa_parent = ctx->op->osd_parent_span->GetContext();
+	  if (op && op->osd_parent_span) {
+	    hsa_parent = op->osd_parent_span->GetContext();
 	    if (hsa_parent.IsValid()) hsa_parent_ptr = &hsa_parent;
 	  }
 	  result = osd->store->read(ch, ghobject_t(oid), 0, 0, osd_op.outdata, 0, hsa_parent_ptr);
@@ -5911,7 +5911,7 @@
     ctx->op_finishers[ctx->current_osd_subop_num].reset(
       new ReadFinisher(osd_op));
   } else {
-    jspan_context read_parent;
+    jspan_context read_parent{false, false};
     const jspan_context *read_parent_ptr = nullptr;
     if (ctx->op && ctx->op->osd_parent_span) {
       read_parent = ctx->op->osd_parent_span->GetContext();
@@ -9400,7 +9400,7 @@
 
 	dout(10) << __func__ << ": async_read noted for " << soid << dendl;
       } else {
-	jspan_context chunk_parent;
+	jspan_context chunk_parent{false, false};
 	const jspan_context *chunk_parent_ptr = nullptr;
 	if (ctx->op && ctx->op->osd_parent_span) {
 	  chunk_parent = ctx->op->osd_parent_span->GetContext();
@@ -10716,14 +10716,10 @@
    * Therefore, we should change the current implementation totally to make EC pool compatible. 
    * As s result, we leave this as a future work.
    */
-  jspan_context dedup_parent;
-  const jspan_context *dedup_parent_ptr = nullptr;
-  if (ctx->op && ctx->op->osd_parent_span) {
-    dedup_parent = ctx->op->osd_parent_span->GetContext();
-    if (dedup_parent.IsValid()) dedup_parent_ptr = &dedup_parent;
-  }
+  // do_cdc is called without an OpRequest in scope (dedup CDC pre-compute),
+  // so we cannot propagate a parent trace context here. Pass nullptr.
   int r = pgbackend->objects_read_sync(
-      oi.soid, 0, oi.size, 0, &bl, dedup_parent_ptr);
+      oi.soid, 0, oi.size, 0, &bl, nullptr);
   if (r < 0) {
     dout(0) << __func__ << " read fail " << oi.soid
             << " len: " << oi.size << " r: " << r << dendl;
-- 
